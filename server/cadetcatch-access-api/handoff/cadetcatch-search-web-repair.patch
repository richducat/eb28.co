+#!/usr/bin/env python3
+from __future__ import annotations
+
+import argparse
+import json
+
+from app.face import build_face_engine
+from app.ingestion import IngestionLedger, process_ingestion_job
+from app.storage import build_storage
+from app.vector_store import build_vector_store
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="Drain the durable CadetCatch photo ingestion queue.")
+    parser.add_argument("--max-jobs", type=int, default=100, help="Maximum jobs to process in this run.")
+    args = parser.parse_args()
+    if args.max_jobs < 1:
+        parser.error("--max-jobs must be at least 1")
+
+    ledger = IngestionLedger()
+    face_engine = build_face_engine()
+    storage = build_storage()
+    vector_store = build_vector_store()
+    vector_store.ensure_ready()
+    processed = 0
+    for _ in range(args.max_jobs):
+        job = process_ingestion_job(
+            ledger=ledger,
+            face_engine=face_engine,
+            storage=storage,
+            vector_store=vector_store,
+        )
+        if job is None:
+            break
+        processed += 1
+        print(json.dumps({
+            "job_id": job["id"],
+            "status": job["status"],
+            "faces_indexed": job["faces_indexed"],
+            "reason": job["reason"],
+        }, sort_keys=True))
+    print(json.dumps({"processed": processed, "summary": ledger.summary()}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
