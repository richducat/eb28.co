+from __future__ import annotations
+
+import hashlib
+import hmac
+import io
+import json
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+from fastapi.testclient import TestClient
+from PIL import Image
+
+from app import main, security
+from app.face import MockFaceEngine
+from app.ingestion import IngestionLedger
+from app.indexer import index_event_directory
+
+
+GATEWAY = "test-web-gateway-key-that-is-at-least-32-characters"
+INGEST_SECRET = "test-ingest-secret-that-is-at-least-32-characters"
+
+
+class MemoryStorage:
+    name = "memory"
+
+    def __init__(self) -> None:
+        self.objects: dict[str, bytes] = {}
+
+    def put_bytes(self, key: str, data: bytes, content_type: str) -> str:
+        self.objects[key] = data
+        return self.url_for_key(key)
+
+    def url_for_key(self, key: str) -> str:
+        return f"https://photos.example.test/{key}"
+
+
+class MemoryVectorStore:
+    name = "memory"
+
+    def __init__(self) -> None:
+        self.points: dict[str, dict] = {}
+
+    def upsert(self, vector: np.ndarray, payload: dict, point_id: str | None = None) -> str:
+        assert point_id
+        self.points[point_id] = {"vector": vector, "payload": payload}
+        return point_id
+
+    def search(self, vector: np.ndarray, event_id: str, top_k: int, min_score: float) -> list[dict]:
+        output = []
+        for point_id, point in self.points.items():
+            if point["payload"]["event_id"] != event_id:
+                continue
+            score = float(np.dot(point["vector"], vector))
+            if score >= min_score:
+                output.append({"id": point_id, "score": score, "payload": point["payload"]})
+        return sorted(output, key=lambda item: item["score"], reverse=True)[:top_k]
+
+    def stats(self, event_id: str | None = None) -> dict:
+        return {"points": len(self.points), "backend": "memory"}
+
+
+def photo_bytes() -> bytes:
+    image = Image.new("RGB", (96, 128), (44, 73, 111))
+    buffer = io.BytesIO()
+    image.save(buffer, format="JPEG", quality=95)
+    return buffer.getvalue()
+
+
+@pytest.fixture()
+def api(tmp_path: Path, monkeypatch: pytest.MonkeyPatch):
+    runtime = SimpleNamespace(
+        max_upload_bytes=25 * 1024 * 1024,
+        default_event_id="default",
+        default_top_k=20,
+        default_min_score=0.45,
+    )
+    auth = SimpleNamespace(
+        web_gateway_key=GATEWAY,
+        ingestion_hmac_secret=INGEST_SECRET,
+        admin_api_key="test-admin-key",
+        search_api_key="",
+    )
+    engine = MockFaceEngine()
+    storage = MemoryStorage()
+    vectors = MemoryVectorStore()
+    source_dir = tmp_path / "source"
+    source_dir.mkdir()
+    source = source_dir / "known.jpg"
+    source.write_bytes(photo_bytes())
+    index_event_directory(
+        event_id="default",
+        source_dir=source_dir,
+        face_engine=engine,
+        storage=storage,
+        vector_store=vectors,
+    )
+
+    monkeypatch.setattr(main, "settings", runtime)
+    monkeypatch.setattr(main, "face_engine", engine)
+    monkeypatch.setattr(main, "storage", storage)
+    monkeypatch.setattr(main, "vector_store", vectors)
+    monkeypatch.setattr(main, "ingestion_ledger", IngestionLedger(tmp_path / "ingestion.sqlite3"))
+    monkeypatch.setattr(security, "settings", auth)
+    return TestClient(main.app), source.read_bytes()
+
+
+def test_mobile_search_contract_accepts_file_and_preserves_legacy_image(api) -> None:
+    client, data = api
+    mobile = client.post(
+        "/search",
+        files={"file": ("known.jpg", data, "image/jpeg")},
+        data={"min_score": "0.80", "top_k": "50", "face_index": "0"},
+    )
+    assert mobile.status_code == 200
+    payload = mobile.json()
+    assert payload["query_faces_detected"] == 1
+    assert payload["matches_returned"] >= 1
+    assert payload["matches"][0]["score"] >= 0.99
+    assert payload["matches"][0]["photo_url"].startswith("https://")
+
+    legacy = client.post(
+        "/search",
+        files={"image": ("known.jpg", data, "image/jpeg")},
+        data={"event_id": "default", "min_score": "0.80", "top_k": "20"},
+    )
+    assert legacy.status_code == 200
+    assert legacy.json()["matches_returned"] >= 1
+
+
+def test_desktop_route_requires_private_gateway(api) -> None:
+    client, data = api
+    denied = client.post(
+        "/desktop/search",
+        files={"file": ("known.jpg", data, "image/jpeg")},
+        data={"min_score": "0.80", "top_k": "50", "face_index": "0"},
+    )
+    assert denied.status_code == 403
+
+    allowed = client.post(
+        "/desktop/search",
+        headers={"X-CadetCatch-Gateway-Key": GATEWAY},
+        files={"file": ("known.jpg", data, "image/jpeg")},
+        data={"min_score": "0.80", "top_k": "50", "face_index": "0"},
+    )
+    assert allowed.status_code == 200
+    assert allowed.json()["matches"][0]["score"] >= 0.99
+
+
+def test_ingestion_notification_requires_valid_hmac(api, monkeypatch: pytest.MonkeyPatch) -> None:
+    client, data = api
+    payload = {
+        "source_url": "https://tyfys.net/cadetcatch/new-photo.jpg",
+        "source_filename": "new-photo.jpg",
+        "sha256": hashlib.sha256(data).hexdigest(),
+        "collection": "default",
+    }
+    raw = json.dumps(payload, separators=(",", ":")).encode()
+    timestamp = str(int(time.time()))
+    signature = hmac.new(
+        INGEST_SECRET.encode(),
+        timestamp.encode() + b"." + raw,
+        hashlib.sha256,
+    ).hexdigest()
+    monkeypatch.setattr(main, "process_ingestion_job", lambda **kwargs: None)
+
+    denied = client.post(
+        "/admin/photo-ingest",
+        content=raw,
+        headers={
+            "Content-Type": "application/json",
+            "X-CadetCatch-Timestamp": timestamp,
+            "X-CadetCatch-Signature": "0" * 64,
+        },
+    )
+    assert denied.status_code == 403
+
+    accepted = client.post(
+        "/admin/photo-ingest",
+        content=raw,
+        headers={
+            "Content-Type": "application/json",
+            "X-CadetCatch-Timestamp": timestamp,
+            "X-CadetCatch-Signature": signature,
+        },
+    )
+    assert accepted.status_code == 202
+    assert accepted.json()["accepted"] is True
+    assert accepted.json()["status"] == "queued"
+
+
+def test_public_readiness_is_false_without_reconciliation(api) -> None:
+    client, _ = api
+    response = client.get("/search/status")
+    assert response.status_code == 200
+    assert response.json()["ready"] is False
+    assert response.json()["reason"] == "no_ingestion_records"
