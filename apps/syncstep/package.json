{
  "name": "syncstep-android",
  "private": true,
  "version": "2.6.0",
  "description": "SyncStep Solana Mobile (Seeker) Android shell: Capacitor wrapper around the SyncStep web game with a native Mobile Wallet Adapter plugin.",
  "scripts": {
    "sync": "npx cap sync android",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "build:release": "cd android && ./gradlew assembleRelease",
    "test": "node test/native-mwa-shim.test.mjs",
    "patch-bundle": "python3 tools/patch-bundle.py"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.99.0",
    "bs58": "^4.0.1",
    "tweetnacl": "^1.0.3"
  }
}
