+from __future__ import annotations
+
+import hashlib
+import io
+from pathlib import Path
+from unittest.mock import patch
+
+import numpy as np
+from PIL import Image
+
+from app.face import MockFaceEngine
+from app.images import normalize_image_for_detection
+from app.ingestion import IngestionLedger, process_ingestion_job
+from app.indexer import index_event_directory
+
+
+class MemoryStorage:
+    name = "memory"
+
+    def __init__(self) -> None:
+        self.objects: dict[str, bytes] = {}
+
+    def put_bytes(self, key: str, data: bytes, content_type: str) -> str:
+        self.objects[key] = data
+        return self.url_for_key(key)
+
+    def url_for_key(self, key: str) -> str:
+        return f"https://photos.example.test/{key}"
+
+
+class MemoryVectorStore:
+    name = "memory"
+
+    def __init__(self) -> None:
+        self.points: dict[str, dict] = {}
+
+    def upsert(self, vector: np.ndarray, payload: dict, point_id: str | None = None) -> str:
+        assert point_id is not None
+        self.points[point_id] = {"vector": vector, "payload": payload}
+        return point_id
+
+    def search(self, vector: np.ndarray, event_id: str, top_k: int, min_score: float) -> list[dict]:
+        matches = []
+        for point_id, point in self.points.items():
+            if point["payload"]["event_id"] != event_id:
+                continue
+            score = float(np.dot(point["vector"], vector))
+            if score >= min_score:
+                matches.append({"id": point_id, "score": score, "payload": point["payload"]})
+        return sorted(matches, key=lambda item: item["score"], reverse=True)[:top_k]
+
+    def stats(self, event_id: str | None = None) -> dict:
+        points = list(self.points.values())
+        if event_id:
+            points = [point for point in points if point["payload"]["event_id"] == event_id]
+        return {"points": len(points)}
+
+
+def image_bytes() -> bytes:
+    image = Image.new("RGB", (80, 120), (22, 56, 94))
+    buffer = io.BytesIO()
+    image.save(buffer, format="JPEG", quality=95)
+    return buffer.getvalue()
+
+
+def test_ingestion_records_indexed_photo_and_is_hash_idempotent(tmp_path: Path) -> None:
+    data = image_bytes()
+    digest = hashlib.sha256(data).hexdigest()
+    ledger = IngestionLedger(tmp_path / "ingestion.sqlite3")
+    storage = MemoryStorage()
+    vectors = MemoryVectorStore()
+    engine = MockFaceEngine()
+    job, created = ledger.enqueue(
+        source_url="https://tyfys.net/cadetcatch/photo-a.jpg",
+        source_filename="photo-a.jpg",
+        event_id="default",
+        sha256=digest,
+    )
+    assert created
+
+    with patch("app.ingestion.download_source_photo", return_value=(data, job["source_url"])):
+        completed = process_ingestion_job(
+            ledger=ledger,
+            face_engine=engine,
+            storage=storage,
+            vector_store=vectors,
+            job_id=job["id"],
+        )
+
+    assert completed["status"] == "indexed"
+    assert completed["faces_indexed"] == 1
+    ledger.set_source_photo_count(1)
+    readiness = ledger.summary()
+    assert readiness["ready"] is True
+    assert readiness["indexed_photo_count"] == 1
+    assert readiness["indexed_face_count"] == 1
+    assert readiness["failures"] == 0
+
+    duplicate, duplicate_created = ledger.enqueue(
+        source_url="https://tyfys.net/cadetcatch/photo-copy.jpg",
+        source_filename="photo-copy.jpg",
+        event_id="default",
+        sha256=digest,
+    )
+    assert duplicate_created
+    assert duplicate["status"] == "skipped"
+    assert duplicate["reason"].startswith("duplicate_sha256:")
+    assert len(vectors.points) == 1
+
+
+def test_hash_mismatch_is_recorded_as_failure(tmp_path: Path) -> None:
+    data = image_bytes()
+    ledger = IngestionLedger(tmp_path / "ingestion.sqlite3")
+    job, _ = ledger.enqueue(
+        source_url="https://tyfys.net/cadetcatch/photo-a.jpg",
+        source_filename="photo-a.jpg",
+        event_id="default",
+        sha256="0" * 64,
+    )
+
+    with patch("app.ingestion.download_source_photo", return_value=(data, job["source_url"])):
+        completed = process_ingestion_job(
+            ledger=ledger,
+            face_engine=MockFaceEngine(),
+            storage=MemoryStorage(),
+            vector_store=MemoryVectorStore(),
+            job_id=job["id"],
+        )
+
+    assert completed["status"] == "failed"
+    assert "SHA-256" in completed["reason"]
+    assert ledger.summary()["failures"] == 1
+
+
+def test_orientation_normalization_keeps_self_match_above_point_99(tmp_path: Path) -> None:
+    source = tmp_path / "source.jpg"
+    source.write_bytes(image_bytes())
+    normalized = normalize_image_for_detection(source, tmp_path / "query.jpg")
+    engine = MockFaceEngine()
+    storage = MemoryStorage()
+    vectors = MemoryVectorStore()
+
+    result = index_event_directory(
+        event_id="default",
+        source_dir=tmp_path,
+        face_engine=engine,
+        storage=storage,
+        vector_store=vectors,
+    )
+    query = engine.extract(normalized)[0]
+    matches = vectors.search(query.embedding, event_id="default", top_k=10, min_score=0.99)
+
+    assert result.photos_indexed >= 1
+    assert matches
+    assert matches[0]["score"] >= 0.99
