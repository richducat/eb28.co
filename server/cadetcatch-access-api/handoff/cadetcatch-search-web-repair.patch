diff --git a/app/ingestion.py b/app/ingestion.py
new file mode 100644
index 0000000..08806b8
--- /dev/null
+++ b/app/ingestion.py
@@ -0,0 +1,400 @@
+from __future__ import annotations
+
+import hashlib
+import re
+import secrets
+import sqlite3
+import tempfile
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+from urllib.parse import quote, urljoin, urlparse
+
+import httpx
+
+from app.config import settings
+from app.face import FaceEngine
+from app.images import is_supported_image, safe_slug
+from app.indexer import index_event_directory
+from app.storage import StorageBackend
+from app.vector_store import VectorStore
+
+
+SHA256_PATTERN = re.compile(r"^[a-f0-9]{64}$")
+
+
+def now_iso() -> str:
+    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
+
+
+def allowed_source_hosts() -> set[str]:
+    return {
+        host.strip().lower()
+        for host in settings.ingestion_source_hosts.split(",")
+        if host.strip()
+    }
+
+
+def validate_source_url(value: str) -> str:
+    parsed = urlparse(value)
+    if parsed.scheme != "https" or not parsed.hostname:
+        raise ValueError("Source URL must use HTTPS.")
+    if parsed.username or parsed.password or parsed.port not in (None, 443):
+        raise ValueError("Source URL contains unsupported authority data.")
+    if parsed.hostname.lower() not in allowed_source_hosts():
+        raise ValueError("Source URL host is not allowed.")
+    return value
+
+
+class IngestionLedger:
+    def __init__(self, path: str | Path | None = None) -> None:
+        self.path = Path(path or settings.ingestion_db_path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self._init_db()
+
+    def connect(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(self.path, timeout=30)
+        conn.row_factory = sqlite3.Row
+        conn.execute("PRAGMA journal_mode = WAL")
+        return conn
+
+    def _init_db(self) -> None:
+        with self.connect() as conn:
+            conn.execute(
+                """
+                CREATE TABLE IF NOT EXISTS ingestion_jobs (
+                    id TEXT PRIMARY KEY,
+                    source_url TEXT UNIQUE NOT NULL,
+                    source_filename TEXT NOT NULL,
+                    event_id TEXT NOT NULL,
+                    sha256 TEXT,
+                    status TEXT NOT NULL,
+                    faces_indexed INTEGER NOT NULL DEFAULT 0,
+                    reason TEXT,
+                    attempts INTEGER NOT NULL DEFAULT 0,
+                    created_at TEXT NOT NULL,
+                    updated_at TEXT NOT NULL,
+                    completed_at TEXT
+                )
+                """
+            )
+            conn.execute("DROP INDEX IF EXISTS idx_ingestion_sha256")
+            conn.execute(
+                """
+                CREATE INDEX IF NOT EXISTS idx_ingestion_sha256
+                ON ingestion_jobs(sha256)
+                WHERE sha256 IS NOT NULL
+                """
+            )
+            conn.execute(
+                """
+                CREATE INDEX IF NOT EXISTS idx_ingestion_status_created
+                ON ingestion_jobs(status, created_at)
+                """
+            )
+            conn.execute(
+                """
+                CREATE TABLE IF NOT EXISTS ingestion_metadata (
+                    key TEXT PRIMARY KEY,
+                    value TEXT NOT NULL,
+                    updated_at TEXT NOT NULL
+                )
+                """
+            )
+
+    @staticmethod
+    def _row(row: sqlite3.Row | None) -> dict[str, Any] | None:
+        return dict(row) if row is not None else None
+
+    def get(self, job_id: str) -> dict[str, Any] | None:
+        with self.connect() as conn:
+            return self._row(conn.execute(
+                "SELECT * FROM ingestion_jobs WHERE id = ?",
+                (job_id,),
+            ).fetchone())
+
+    def enqueue(
+        self,
+        *,
+        source_url: str,
+        source_filename: str,
+        event_id: str,
+        sha256: str | None = None,
+    ) -> tuple[dict[str, Any], bool]:
+        source_url = validate_source_url(source_url)
+        digest = sha256.lower() if sha256 else None
+        if digest and not SHA256_PATTERN.fullmatch(digest):
+            raise ValueError("sha256 must be a 64-character lowercase hex digest.")
+        timestamp = now_iso()
+        with self.connect() as conn:
+            existing = conn.execute(
+                "SELECT * FROM ingestion_jobs WHERE source_url = ?",
+                (source_url,),
+            ).fetchone()
+            if existing is not None:
+                return dict(existing), False
+            duplicate = None
+            if digest:
+                duplicate = conn.execute(
+                    "SELECT id FROM ingestion_jobs WHERE sha256 = ? ORDER BY created_at LIMIT 1",
+                    (digest,),
+                ).fetchone()
+            job_id = secrets.token_urlsafe(18)
+            initial_status = "skipped" if duplicate is not None else "queued"
+            reason = f"duplicate_sha256:{duplicate['id']}" if duplicate is not None else None
+            completed_at = timestamp if duplicate is not None else None
+            conn.execute(
+                """
+                INSERT INTO ingestion_jobs (
+                    id, source_url, source_filename, event_id, sha256, status,
+                    faces_indexed, reason, attempts, created_at, updated_at, completed_at
+                ) VALUES (?, ?, ?, ?, ?, ?, 0, ?, 0, ?, ?, ?)
+                """,
+                (
+                    job_id,
+                    source_url,
+                    source_filename[:240],
+                    safe_slug(event_id),
+                    digest,
+                    initial_status,
+                    reason,
+                    timestamp,
+                    timestamp,
+                    completed_at,
+                ),
+            )
+            row = conn.execute("SELECT * FROM ingestion_jobs WHERE id = ?", (job_id,)).fetchone()
+        return dict(row), True
+
+    def claim(self, job_id: str | None = None) -> dict[str, Any] | None:
+        with self.connect() as conn:
+            conn.execute("BEGIN IMMEDIATE")
+            if job_id:
+                row = conn.execute(
+                    "SELECT * FROM ingestion_jobs WHERE id = ? AND status = 'queued'",
+                    (job_id,),
+                ).fetchone()
+            else:
+                row = conn.execute(
+                    "SELECT * FROM ingestion_jobs WHERE status = 'queued' ORDER BY created_at LIMIT 1"
+                ).fetchone()
+            if row is None:
+                return None
+            conn.execute(
+                """
+                UPDATE ingestion_jobs
+                SET status = 'processing', attempts = attempts + 1, updated_at = ?
+                WHERE id = ?
+                """,
+                (now_iso(), row["id"]),
+            )
+            updated = conn.execute(
+                "SELECT * FROM ingestion_jobs WHERE id = ?",
+                (row["id"],),
+            ).fetchone()
+        return dict(updated)
+
+    def bind_hash(self, *, job_id: str, sha256: str) -> str | None:
+        digest = sha256.lower()
+        if not SHA256_PATTERN.fullmatch(digest):
+            raise ValueError("Downloaded file did not produce a valid SHA-256 digest.")
+        with self.connect() as conn:
+            duplicate = conn.execute(
+                "SELECT id FROM ingestion_jobs WHERE sha256 = ? AND id != ?",
+                (digest, job_id),
+            ).fetchone()
+            if duplicate is not None:
+                conn.execute(
+                    "UPDATE ingestion_jobs SET sha256 = ?, updated_at = ? WHERE id = ?",
+                    (digest, now_iso(), job_id),
+                )
+                return str(duplicate["id"])
+            conn.execute(
+                "UPDATE ingestion_jobs SET sha256 = ?, updated_at = ? WHERE id = ?",
+                (digest, now_iso(), job_id),
+            )
+        return None
+
+    def complete(self, *, job_id: str, status: str, faces_indexed: int, reason: str | None) -> None:
+        if status not in {"indexed", "skipped", "failed"}:
+            raise ValueError("Invalid terminal ingestion status.")
+        timestamp = now_iso()
+        with self.connect() as conn:
+            conn.execute(
+                """
+                UPDATE ingestion_jobs
+                SET status = ?, faces_indexed = ?, reason = ?, updated_at = ?, completed_at = ?
+                WHERE id = ?
+                """,
+                (status, max(0, int(faces_indexed)), reason, timestamp, timestamp, job_id),
+            )
+
+    def set_source_photo_count(self, count: int) -> None:
+        with self.connect() as conn:
+            conn.execute(
+                """
+                INSERT INTO ingestion_metadata(key, value, updated_at)
+                VALUES ('source_photo_count', ?, ?)
+                ON CONFLICT(key) DO UPDATE SET value = excluded.value, updated_at = excluded.updated_at
+                """,
+                (str(max(0, count)), now_iso()),
+            )
+
+    def summary(self) -> dict[str, Any]:
+        with self.connect() as conn:
+            counts = {
+                row["status"]: int(row["count"])
+                for row in conn.execute(
+                    "SELECT status, COUNT(*) AS count FROM ingestion_jobs GROUP BY status"
+                ).fetchall()
+            }
+            total = int(conn.execute("SELECT COUNT(*) AS count FROM ingestion_jobs").fetchone()["count"])
+            faces = int(conn.execute(
+                "SELECT COALESCE(SUM(faces_indexed), 0) AS count FROM ingestion_jobs WHERE status = 'indexed'"
+            ).fetchone()["count"])
+            last_success = conn.execute(
+                "SELECT MAX(completed_at) AS value FROM ingestion_jobs WHERE status = 'indexed'"
+            ).fetchone()["value"]
+            metadata = conn.execute(
+                "SELECT value FROM ingestion_metadata WHERE key = 'source_photo_count'"
+            ).fetchone()
+        source_count = int(metadata["value"]) if metadata is not None else 0
+        indexed = counts.get("indexed", 0)
+        skipped = counts.get("skipped", 0)
+        failed = counts.get("failed", 0)
+        queued = counts.get("queued", 0)
+        processing = counts.get("processing", 0)
+        expected = source_count or total
+        accounted = indexed + skipped
+        ready = expected > 0 and accounted >= expected and failed == 0 and queued == 0 and processing == 0
+        reason = None
+        if expected == 0:
+            reason = "no_ingestion_records"
+        elif failed:
+            reason = "ingestion_failures"
+        elif queued or processing:
+            reason = "ingestion_in_progress"
+        elif accounted < expected:
+            reason = "source_reconciliation_incomplete"
+        return {
+            "ready": ready,
+            "source_photo_count": source_count,
+            "total_records": total,
+            "indexed_photo_count": indexed,
+            "indexed_face_count": faces,
+            "skipped": skipped,
+            "failures": failed,
+            "queued": queued,
+            "processing": processing,
+            "last_successful_ingestion": last_success,
+            "reason": reason,
+        }
+
+
+def download_source_photo(source_url: str) -> tuple[bytes, str]:
+    validate_source_url(source_url)
+    data = bytearray()
+    with httpx.Client(timeout=30, follow_redirects=True) as client:
+        with client.stream("GET", source_url, headers={"Accept": "image/*"}) as response:
+            response.raise_for_status()
+            final_url = validate_source_url(str(response.url))
+            for chunk in response.iter_bytes():
+                data.extend(chunk)
+                if len(data) > settings.max_upload_bytes:
+                    raise ValueError("Source image exceeds the upload limit.")
+    if not data:
+        raise ValueError("Source image is empty.")
+    return bytes(data), final_url
+
+
+def process_ingestion_job(
+    *,
+    ledger: IngestionLedger,
+    face_engine: FaceEngine,
+    storage: StorageBackend,
+    vector_store: VectorStore,
+    job_id: str | None = None,
+) -> dict[str, Any] | None:
+    job = ledger.claim(job_id)
+    if job is None:
+        return None
+    try:
+        data, _ = download_source_photo(job["source_url"])
+        digest = hashlib.sha256(data).hexdigest()
+        if job["sha256"] and not secrets.compare_digest(job["sha256"], digest):
+            raise ValueError("Source SHA-256 does not match the upload notification.")
+        duplicate_id = ledger.bind_hash(job_id=job["id"], sha256=digest)
+        if duplicate_id:
+            ledger.complete(
+                job_id=job["id"],
+                status="skipped",
+                faces_indexed=0,
+                reason=f"duplicate_sha256:{duplicate_id}",
+            )
+            return ledger.get(job["id"])
+
+        suffix = Path(urlparse(job["source_url"]).path).suffix.lower()
+        source_name = safe_slug(job["source_filename"])
+        if not suffix:
+            suffix = Path(source_name).suffix.lower()
+        if not is_supported_image(Path(f"photo{suffix}")):
+            raise ValueError("Source file extension is not supported.")
+        with tempfile.TemporaryDirectory(prefix="cadetcatch-ingest-") as temp_dir:
+            image_path = Path(temp_dir) / f"{Path(source_name).stem or 'photo'}{suffix}"
+            image_path.write_bytes(data)
+            result = index_event_directory(
+                event_id=job["event_id"],
+                source_dir=Path(temp_dir),
+                face_engine=face_engine,
+                storage=storage,
+                vector_store=vector_store,
+            )
+        if result.photos_indexed == 1:
+            ledger.complete(
+                job_id=job["id"],
+                status="indexed",
+                faces_indexed=result.faces_indexed,
+                reason=None,
+            )
+        else:
+            reason = "; ".join(result.skipped) or "Photo was not indexed."
+            terminal = "skipped" if "no faces detected" in reason.lower() else "failed"
+            ledger.complete(job_id=job["id"], status=terminal, faces_indexed=0, reason=reason[:1000])
+    except Exception as error:
+        ledger.complete(
+            job_id=job["id"],
+            status="failed",
+            faces_indexed=0,
+            reason=str(error)[:1000],
+        )
+    return ledger.get(job["id"])
+
+
+def reconcile_source_manifest(ledger: IngestionLedger) -> dict[str, int]:
+    manifest_url = validate_source_url(settings.source_manifest_url)
+    with httpx.Client(timeout=30, follow_redirects=True) as client:
+        response = client.get(manifest_url, headers={"Accept": "application/json"})
+        response.raise_for_status()
+        validate_source_url(str(response.url))
+        payload = response.json()
+    photos = payload.get("photos") if isinstance(payload, dict) else None
+    if not isinstance(photos, list):
+        raise ValueError("Source manifest did not contain a photos list.")
+
+    enqueued = 0
+    existing = 0
+    for value in photos:
+        relative = str(value).strip().lstrip("/")
+        if not relative or ".." in relative.split("/"):
+            continue
+        encoded = "/".join(quote(part, safe="") for part in relative.split("/"))
+        source_url = urljoin(f"{settings.source_public_base_url}/", encoded)
+        _, created = ledger.enqueue(
+            source_url=source_url,
+            source_filename=Path(relative).name,
+            event_id=settings.default_event_id,
+        )
+        enqueued += int(created)
+        existing += int(not created)
+    ledger.set_source_photo_count(len(photos))
+    return {"source_photo_count": len(photos), "enqueued": enqueued, "existing": existing}
