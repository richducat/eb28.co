  "reviewDetail": {
    "ok": true,
    "response": {
      "data": {
        "type": "appStoreReviewDetails",
        "id": "5156ed7a-cec0-4239-a665-bd42f2b5d525",
        "attributes": {
          "contactFirstName": "Richard",
          "contactLastName": "Ducat",
          "contactPhone": "+16023063920",
          "contactEmail": "support@eb28.co",
          "demoAccountName": null,
          "demoAccountPassword": null,
          "demoAccountRequired": false,
          "notes": "CadetCatch requires no login. To test build 57: launch the app, open Roster, and add a cadet profile with a clear face photo from Photos. Open Sources and confirm the built-in public photo sources are available, or add another secure public photo page that can be opened in Safari. Open Home and tap Check Photos. The app shows source progress, discovered image count, checked image count, and possible match count while scanning. Open Photos to review possible matches; previews remain covered until single-photo access or monthly access is active. Open Photo Access from More or from a locked photo to review Family Monthly, 1 month, monthly pricing, auto-renewal disclosure, Restore Purchases, Privacy Policy, and Terms of Use before purchase. Photos permission is used only for selected profile photos. CadetCatch checks secure public pages built in or added by the user and does not access private social accounts, private photo libraries, private websites, or logged-in pages in this build. No camera, location, tracking, ads, or push notifications are used."
        },
